# Local API (Wrangler uses .dev.vars for secrets — copy patterns there)
# AUTH_STUB=1 enables X-User-Id header identity for local development only.
# It is refused outside ENVIRONMENT=development/test by the configGuard
# middleware, and is absent from wrangler.toml's [env.production].

# Envelope-encryption root key. Optional in development (a documented dev
# placeholder is derived instead); REQUIRED everywhere else — every request
# returns 503 configuration_error until it is set, and it must be at least 32
# characters and must not be the placeholder.
#   wrangler secret put ROOT_KEK --env production
# ROOT_KEK=

# Internal WordPress → Cloudflare release auth. Required for
# POST /internal/content-releases outside development.
#   wrangler secret put SERVICE_AUTH_TOKEN --env production
# SERVICE_AUTH_TOKEN=

# Identity provider (OIDC). Required outside development: every request returns
# 503 configuration_error until all three are set to real values. These are
# configuration rather than secrets — the JWKS document is public — so they live
# in wrangler.toml [vars], not in `wrangler secret put`.
#
# The shipped placeholders point at issuer.invalid, a reserved TLD that can
# never resolve. configGuard rejects them outside development, so a deploy that
# forgets to replace them fails loudly at the guard instead of returning opaque
# 401s from inside the token verifier.
OIDC_ISSUER=https://issuer.invalid
OIDC_AUDIENCE=patternlike-dev
OIDC_JWKS_URL=https://issuer.invalid/.well-known/jwks.json

# Web client development. Vite proxies /v1 to the local Worker by default.
# These values are local-only while production identity and consent APIs are
# still M1 work in progress.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8787
# VITE_DEV_USER_ID=usr_local_dev_0001
# VITE_CONSENT_ID=cns_local_web_0001

node_modules/
dist/
# Release-builder output: unsigned and signed content-release bodies. A signed
# release committed here would be an ingestable artifact nobody reviewed in a
# pull request.
build/
*.tsbuildinfo
.wrangler/
# Auth0 CLI state. XDG_CONFIG_HOME resolves to a relative `.config` in some
# shells here, so `auth0 login` writes tenant state into whatever directory it
# was run from. No credentials land here (the CLI keeps tokens in the Windows
# Credential Manager) but it is per-machine state and must not be committed.
.config/
.dev.vars
.env
.env.*
!.env.example
*.log
.DS_Store
coverage/
.turbo/
.worktrees/
apps/api/.wrangler/
# Ephemeris binaries: download via npm run ephe:download (not committed by default)
apps/calc-stub/data/ephe/*.se1
apps/calc-stub/data/ephe/*.txt
!apps/calc-stub/data/.gitkeep
*.pyc
__pycache__/
.venv/
spec-bundle/_analyze*
spec-bundle/_analysis*
spec-bundle/_docx*
.impeccable/review/
.playwright-cli/
apps/web/dist-portrait/

{
  "name": "@patternlike/api",
  "version": "0.2.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply patternlike-ops --local",
    "//deploy": "Ships apps/web/dist as static assets. Prefer `npm run deploy:api` from the repository root, which builds the web app first.",
    "deploy": "wrangler deploy --env production",
    "//db:local": "Applies the ordered db/d1 directory, not just 0001. Deleting .wrangler state is an explicit developer reset, not the migration mechanism."
  },
  "dependencies": {
    "@patternlike/shared": "0.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "hono": "^4.12.32",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.1",
    "@cloudflare/workers-types": "^4.20250525.0",
    "@types/tz-lookup": "^6.1.2",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.16.1"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patternlike.app/contracts/daily-uncertainty-v1/reading-generation-request.schema.json",
  "title": "Daily Reading Generation Request 0.5.1",
  "description": "Successor provider projection carrying the complete typed disclosure plan. Published output remains daily-reading-v5 at 0.5.0. No birth instant, coordinates, location code, or unreviewed summary crosses this boundary.",
  "$defs": {
    "readingGenerationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "prompt_version",
        "selection_policy_version",
        "output_schema",
        "local_date",
        "locale",
        "birth_time_accuracy",
        "suppressed_features",
        "facts",
        "context",
        "prior_readings",
        "composition",
        "uncertainty_disclosure"
      ],
      "properties": {
        "schema_version": {
          "const": "0.5.1"
        },
        "prompt_version": {
          "$ref": "https://patternlike.app/contracts/m3/common.schema.json#/$defs/policyVersion"
        },
        "selection_policy_version": {
          "$ref": "https://patternlike.app/contracts/m3/common.schema.json#/$defs/policyVersion"
        },
        "output_schema": {
          "$ref": "https://patternlike.app/contracts/m5/common.schema.json#/$defs/outputSchemaName"
        },
        "local_date": {
          "$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/isoDate",
          "description": "The reader's own local day. The only calendar value in the packet, and the candidate must echo it exactly."
        },
        "locale": {
          "$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/localeTag"
        },
        "birth_time_accuracy": {
          "$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/birthTimeAccuracy",
          "description": "The accuracy LABEL and its consequences cross the boundary; the birth instant, place, and coordinates never do."
        },
        "suppressed_features": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://patternlike.app/contracts/m3/common.schema.json#/$defs/suppressedFeatureClass"
          }
        },
        "domain_preference": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/lifeDomain"
            }
          ]
        },
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://patternlike.app/contracts/m5/reading-generation-request.schema.json#/$defs/requestFact"
          },
          "description": "Ordered by lane_rank, then by DER-02 ranking score within the lane (descending, with a total tie-break on exact-pass instant and fact_id). Never empty: the calculated daily-sky layer guarantees at least an anchor and a phase, so a zero-cycle day is still a factual day."
        },
        "context": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "https://patternlike.app/contracts/m5/reading-generation-request.schema.json#/$defs/requestContext"
          }
        },
        "prior_readings": {
          "type": "array",
          "minItems": 0,
          "maxItems": 7,
          "items": {
            "$ref": "https://patternlike.app/contracts/m5/reading-generation-request.schema.json#/$defs/priorReadingExcerpt"
          }
        },
        "composition": {
          "$ref": "https://patternlike.app/contracts/m5/reading-generation-request.schema.json#/$defs/readingComposition"
        },
        "uncertainty_disclosure": {
          "$ref": "uncertainty.schema.json#/$defs/uncertaintyDisclosurePlan"
        }
      }
    }
  },
  "$ref": "#/$defs/readingGenerationRequest"
}

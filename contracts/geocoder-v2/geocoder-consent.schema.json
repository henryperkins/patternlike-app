{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patternlike.app/contracts/geocoder-v2/geocoder-consent.schema.json",
  "title": "Geoapify revocable geocoder consent v0.8.1",
  "$defs": {
    "geocoderConsentUiSurface": {
      "type": "string",
      "enum": ["onboarding", "privacy_center"]
    },
    "geocoderDisclosureLinks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patternlike_terms",
        "patternlike_privacy",
        "geoapify_terms",
        "geoapify_privacy"
      ],
      "properties": {
        "patternlike_terms": {
          "type": "string",
          "const": "/terms.html"
        },
        "patternlike_privacy": {
          "type": "string",
          "const": "/privacy.html"
        },
        "geoapify_terms": {
          "type": "string",
          "const": "https://www.geoapify.com/terms-and-conditions/"
        },
        "geoapify_privacy": {
          "type": "string",
          "const": "https://www.geoapify.com/privacy-policy/"
        }
      }
    },
    "geocoderDisclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "links"],
      "properties": {
        "text": {
          "type": "string",
          "const": "Geoapify birthplace search is optional. If you enable it, Pattern/Like sends the city or place text you type and your language preference (when available) to Geoapify. After you choose a suggestion, it sends the selected Geoapify place identifier and language preference to retrieve the place. Pattern/Like does not send your birth date or time, device location, user, account, birth-profile, or consent identifiers, or the app-owned search session token. Geoapify also receives Pattern/Like's API credential and network metadata such as the server IP. Geoapify logs API requests for access control, usage counting, troubleshooting, and performance; its privacy policy says successful request logs are generally kept no longer than 24 hours. Pattern/Like does not store your query or unselected suggestions. It encrypts the selected place and coordinates under your account key, retaining the selection handoff for up to 24 hours and the saved values in your birth profile. Deleting your Pattern/Like account does not delete Geoapify's separate records. You can decline or withdraw this permission and enter the place, coordinates, and time zone manually."
        },
        "links": { "$ref": "#/$defs/geocoderDisclosureLinks" }
      }
    },
    "geocoderConsentGrantRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version"],
      "properties": {
        "policy_version": {
          "type": "string",
          "const": "geoapify-2026-09-04"
        }
      }
    },
    "geocoderConsentResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "source_id",
        "permission_tier",
        "allowed_uses",
        "provider",
        "scopes",
        "connector_account_id",
        "status",
        "policy_version",
        "granted_at",
        "ui_surface",
        "disclosure"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.8.1"
        },
        "kind": { "type": "string", "const": "product_source" },
        "source_id": { "type": "string", "const": "AST-02" },
        "permission_tier": { "type": "integer", "const": 0 },
        "allowed_uses": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            { "type": "string", "const": "chart_fact" },
            { "type": "string", "const": "timezone_resolution" }
          ],
          "items": false
        },
        "provider": {
          "type": "string",
          "const": "geoapify"
        },
        "scopes": {
          "type": "array",
          "minItems": 0,
          "maxItems": 0,
          "items": false
        },
        "connector_account_id": { "type": "null", "const": null },
        "status": {
          "type": "string",
          "enum": ["granted", "not_granted"]
        },
        "policy_version": {
          "type": "string",
          "const": "geoapify-2026-09-04"
        },
        "granted_at": {
          "$ref": "https://patternlike.app/contracts/m8/common.schema.json#/$defs/nullableDateTime"
        },
        "ui_surface": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/geocoderConsentUiSurface" }
          ]
        },
        "disclosure": { "$ref": "#/$defs/geocoderDisclosure" }
      },
      "oneOf": [
        {
          "properties": {
            "status": { "const": "granted" },
            "granted_at": {
              "$ref": "https://patternlike.app/contracts/m8/common.schema.json#/$defs/dateTime"
            },
            "ui_surface": { "$ref": "#/$defs/geocoderConsentUiSurface" }
          },
          "required": ["status", "granted_at", "ui_surface"]
        },
        {
          "properties": {
            "status": { "const": "not_granted" },
            "granted_at": { "type": "null" },
            "ui_surface": { "type": "null" }
          },
          "required": ["status", "granted_at", "ui_surface"]
        }
      ]
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/geocoderConsentGrantRequest" },
    { "$ref": "#/$defs/geocoderConsentResponse" }
  ]
}

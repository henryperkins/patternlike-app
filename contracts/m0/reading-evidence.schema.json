{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patternlike.app/contracts/m0/reading-evidence.schema.json",
  "title": "Reading Evidence and Assembly",
  "description": "Paragraph-level provenance graph (DER-17), daily reading evidence API shape, and constrained reading-assembly request (DOCX reading assembly contract). Every published paragraph resolves to calculated facts and approved content, or is explicitly labeled as user context.",
  "$defs": {
    "factRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fact_type"],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/opaqueId",
          "description": "Calculated fact id (cycle instance, natal feature, aspect, etc.)."
        },
        "fact_type": {
          "type": "string",
          "enum": [
            "chart_snapshot",
            "natal_position",
            "natal_aspect",
            "natal_pattern",
            "cycle_instance",
            "exact_pass",
            "lunation",
            "station_ingress",
            "uncertainty_feature",
            "other_calculated"
          ]
        },
        "phase": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "common.schema.json#/$defs/cyclePhase" }
          ]
        },
        "orb_deg": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 12
        },
        "chart_fingerprint": {
          "type": ["string", "null"]
        },
        "technique": {
          "type": ["string", "null"],
          "description": "e.g. transit, progression, return — must be reproducible under the chart contract."
        }
      }
    },
    "contentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fragment_id", "content_version", "release_version"],
      "properties": {
        "fragment_id": {
          "type": "string",
          "minLength": 1,
          "description": "Editorial fragment id from the active signed content release."
        },
        "content_version": {
          "type": "string",
          "minLength": 1
        },
        "release_version": {
          "type": "string",
          "minLength": 1
        },
        "content_type": {
          "type": "string",
          "enum": [
            "astrology_pattern",
            "astrology_cycle",
            "astrology_phase",
            "astrology_modifier",
            "astrology_prompt",
            "astrology_safety_rule",
            "fallback_copy"
          ]
        },
        "bundle_hash": {
          "type": ["string", "null"]
        }
      }
    },
    "contextRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_id", "source_id", "allowed_use", "evidence_lane"],
      "properties": {
        "signal_id": {
          "$ref": "common.schema.json#/$defs/opaqueId"
        },
        "source_id": {
          "$ref": "common.schema.json#/$defs/ingestibleSourceId",
          "description": "Evidence must not reference NO-* excluded sources."
        },
        "allowed_use": {
          "$ref": "common.schema.json#/$defs/allowedUse"
        },
        "evidence_lane": {
          "$ref": "common.schema.json#/$defs/evidenceLane"
        },
        "label": {
          "type": "string",
          "enum": [
            "user_reported",
            "user_selected",
            "optional_context",
            "operational",
            "environment",
            "derived_aggregate",
            "experimental"
          ]
        }
      },
      "description": "Context may rank/frame only; never presented as independently discovered by astrology."
    },
    "rankingFactor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factor", "reason"],
      "properties": {
        "factor": {
          "type": "string",
          "enum": [
            "exactness",
            "body_importance",
            "target_importance",
            "rarity",
            "angularity",
            "phase",
            "technique_weight",
            "user_priority",
            "domain_match",
            "continuity",
            "repetition_penalty",
            "resonance_feedback",
            "uncertainty_filter",
            "safety_filter",
            "other"
          ]
        },
        "weight": {
          "type": ["number", "null"]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Machine-readable short reason for the evidence drawer; not engagement-only ranking (DER-02)."
        }
      }
    },
    "paragraphEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paragraph_id",
        "role",
        "evidence_lane",
        "facts",
        "content",
        "context_signals"
      ],
      "properties": {
        "paragraph_id": {
          "$ref": "common.schema.json#/$defs/opaqueId"
        },
        "role": {
          "type": "string",
          "enum": [
            "primary_theme",
            "supporting_theme",
            "reflection",
            "phase_context",
            "timing",
            "uncertainty_notice",
            "context_label",
            "safety_fallback"
          ]
        },
        "evidence_lane": {
          "$ref": "common.schema.json#/$defs/evidenceLane"
        },
        "text_hash": {
          "type": ["string", "null"],
          "description": "Hash of published paragraph text. Plaintext may be encrypted at rest separately."
        },
        "facts": {
          "type": "array",
          "items": { "$ref": "#/$defs/factRef" }
        },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/contentRef" }
        },
        "context_signals": {
          "type": "array",
          "items": { "$ref": "#/$defs/contextRef" }
        },
        "ranking_factors": {
          "type": "array",
          "items": { "$ref": "#/$defs/rankingFactor" }
        },
        "model_output": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "used": { "type": "boolean" },
            "route_version": { "type": ["string", "null"] },
            "model_id": { "type": ["string", "null"] },
            "response_hash": { "type": ["string", "null"] },
            "validated": { "type": "boolean" }
          },
          "description": "Optional constrained-model linkage. Never store prompt/response text here."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_lane": { "const": "celestial_facts" }
            },
            "required": ["evidence_lane"]
          },
          "then": {
            "properties": {
              "facts": { "minItems": 1 },
              "content": { "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_lane": { "const": "user_and_context" }
            },
            "required": ["evidence_lane"]
          },
          "then": {
            "properties": {
              "context_signals": { "minItems": 1 }
            },
            "description": "Context-only paragraphs must carry explicit context linkage and should use context_label role when not tied to celestial eligibility."
          }
        }
      ]
    },
    "validationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "fallback_used", "checks"],
      "properties": {
        "passed": { "type": "boolean" },
        "fallback_used": {
          "type": "boolean",
          "description": "True when model failure or validation rejection selected reviewed deterministic copy."
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check", "result"],
            "properties": {
              "check": {
                "type": "string",
                "enum": [
                  "schema",
                  "provenance",
                  "dates",
                  "unsupported_facts",
                  "fatalism",
                  "diagnosis",
                  "source_laundering",
                  "eligibility_allowlist",
                  "uncertainty_constraints",
                  "consent_freshness",
                  "repetition",
                  "other"
                ]
              },
              "result": {
                "type": "string",
                "enum": ["pass", "fail", "skip"]
              },
              "detail_code": {
                "type": ["string", "null"],
                "description": "Opaque error class only; no private payloads."
              }
            }
          }
        }
      }
    },
    "readingEvidenceGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "reading_id",
        "reading_key",
        "user_id",
        "local_date",
        "release_version",
        "chart_fingerprint",
        "contract_id",
        "assembly_mode",
        "paragraphs",
        "validation",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "$ref": "common.schema.json#/$defs/schemaVersion"
        },
        "reading_id": {
          "$ref": "common.schema.json#/$defs/opaqueId"
        },
        "reading_key": {
          "type": "string",
          "pattern": "^user:[A-Za-z0-9_.:-]+:[0-9]{4}-[0-9]{2}-[0-9]{2}:.+$",
          "description": "Idempotency uniqueness: user_id + local_date + release_version (GenerateDailyReading)."
        },
        "user_id": { "$ref": "common.schema.json#/$defs/userId" },
        "local_date": { "$ref": "common.schema.json#/$defs/isoDate" },
        "release_version": { "type": "string", "minLength": 1 },
        "chart_fingerprint": {
          "$ref": "common.schema.json#/$defs/contentHash"
        },
        "contract_id": { "type": "string", "minLength": 1 },
        "contract_version": {
          "$ref": "common.schema.json#/$defs/semanticVersion"
        },
        "assembly_mode": {
          "type": "string",
          "enum": ["deterministic", "constrained_model"],
          "description": "Deterministic is default and must cover every launch configuration."
        },
        "primary_theme": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "cycle_id": { "type": "string" },
            "phase": { "$ref": "common.schema.json#/$defs/cyclePhase" },
            "fragment_ids": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "supporting_theme": {
          "type": ["object", "null"],
          "description": "At most one supporting influence per daily reading.",
          "additionalProperties": false,
          "properties": {
            "cycle_id": { "type": "string" },
            "phase": { "$ref": "common.schema.json#/$defs/cyclePhase" },
            "fragment_ids": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/paragraphEvidence" }
        },
        "validation": { "$ref": "#/$defs/validationResult" },
        "content_hash": {
          "type": ["string", "null"],
          "description": "daily_readings.hash of the published reading payload."
        },
        "created_at": {
          "$ref": "common.schema.json#/$defs/isoDateTime"
        }
      }
    },
    "readingAssemblyRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "reading_key",
        "output_schema",
        "facts",
        "approved_fragments",
        "context"
      ],
      "properties": {
        "schema_version": {
          "$ref": "common.schema.json#/$defs/schemaVersion"
        },
        "reading_key": {
          "type": "string",
          "pattern": "^user:[A-Za-z0-9_.:-]+:[0-9]{4}-[0-9]{2}-[0-9]{2}:.+$"
        },
        "output_schema": {
          "type": "string",
          "const": "daily-reading-v2",
          "description": "Pinned structured output schema name for deterministic or constrained-model assembly."
        },
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": { "type": "string" },
              "phase": {
                "oneOf": [
                  { "type": "null" },
                  { "$ref": "common.schema.json#/$defs/cyclePhase" }
                ]
              },
              "orb": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 12
              }
            }
          },
          "description": "Calculated fact IDs only — never raw health, full calendar, or raw journal bodies."
        },
        "approved_fragments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Eligible editorial fragment ids/text handles from DER-18. Model may not introduce fragments outside this set."
        },
        "context": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["signal_id", "allowed_use"],
            "properties": {
              "signal_id": { "type": "string" },
              "allowed_use": {
                "$ref": "common.schema.json#/$defs/allowedUse"
              },
              "framing": {
                "type": ["string", "null"],
                "maxLength": 200,
                "description": "Minimal framing signal only (e.g. domain preference id), not raw private content."
              }
            }
          }
        },
        "locale": {
          "$ref": "common.schema.json#/$defs/localeTag"
        },
        "domain_preference": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "common.schema.json#/$defs/lifeDomain" }
          ]
        }
      }
    }
  },
  "oneOf": [
    {
      "title": "ReadingEvidenceGraph",
      "$ref": "#/$defs/readingEvidenceGraph"
    },
    {
      "title": "ReadingAssemblyRequest",
      "$ref": "#/$defs/readingAssemblyRequest"
    },
    {
      "title": "ParagraphEvidence",
      "$ref": "#/$defs/paragraphEvidence"
    }
  ]
}

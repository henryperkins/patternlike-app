{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patternlike.app/contracts/m4/cycle-scan-receipt.schema.json",
  "title": "M4 immutable cycle scan receipt",
  "$defs": {
    "cycleScanReceipt": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "receipt_id", "chart_fingerprint", "local_date",
        "scheduling_timezone", "window_from", "window_to", "tzdb_version",
        "local_day_resolution_policy_version", "contract_id", "contract_version",
        "cycle_policy_id", "cycle_policy_version", "orb_policy_id",
        "orb_policy_version", "receipt_epoch", "container_version",
        "ephemeris_data_version", "semantic_request_hash",
        "semantic_result_hash", "raw_response_sha256", "cycles", "created_at"
      ],
      "properties": {
        "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
        "receipt_id": { "$ref": "common.schema.json#/$defs/scanReceiptId" },
        "chart_fingerprint": { "$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/sha256Hex" },
        "local_date": { "$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/isoDate" },
        "scheduling_timezone": { "$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/ianaTimeZone" },
        "window_from": { "$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/isoDateTime" },
        "window_to": { "$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/isoDateTime" },
        "tzdb_version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "local_day_resolution_policy_version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "contract_id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "contract_version": { "$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/semanticVersion" },
        "cycle_policy_id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "cycle_policy_version": { "$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/semanticVersion" },
        "orb_policy_id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "orb_policy_version": { "$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/semanticVersion" },
        "receipt_epoch": { "type": "integer", "minimum": 1 },
        "container_version": { "type": "string", "minLength": 1, "maxLength": 200 },
        "ephemeris_data_version": { "type": "string", "minLength": 1, "maxLength": 200 },
        "semantic_request_hash": { "$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/sha256Hex" },
        "semantic_result_hash": { "$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/sha256Hex" },
        "raw_response_sha256": { "$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/sha256Hex" },
        "cycles": { "type": "array", "items": { "$ref": "https://patternlike.app/contracts/m3/cycle-response.schema.json#/$defs/normalizedCycle" } },
        "created_at": { "$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/isoDateTime" }
      }
    }
  }
}

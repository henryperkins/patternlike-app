{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patternlike.app/contracts/m6/export-status.schema.json",
  "title": "Account export status",
  "$defs": {
    "exportStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "export_request_id",
        "status",
        "requested_at",
        "status_updated_at",
        "completed_at",
        "expires_at",
        "download_available",
        "error_class"
      ],
      "properties": {
        "schema_version": {
          "$ref": "common.schema.json#/$defs/schemaVersion"
        },
        "export_request_id": {
          "$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/opaqueId"
        },
        "status": {
          "type": "string",
          "enum": ["queued", "running", "ready", "failed", "expired"]
        },
        "requested_at": {
          "$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/isoDateTime"
        },
        "status_updated_at": {
          "$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/isoDateTime"
        },
        "completed_at": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/isoDateTime"}
          ]
        },
        "expires_at": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/isoDateTime"}
          ]
        },
        "download_available": {
          "type": "boolean"
        },
        "error_class": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "common.schema.json#/$defs/exportErrorClass"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "ready"}}, "required": ["status"]},
          "then": {
            "properties": {
              "download_available": {"const": true},
              "completed_at": {"type": "string", "format": "date-time"},
              "expires_at": {"type": "string", "format": "date-time"},
              "error_class": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"enum": ["queued", "running"]}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "download_available": {"const": false},
              "completed_at": {"type": "null"},
              "expires_at": {"type": "null"},
              "error_class": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "failed"}}, "required": ["status"]},
          "then": {
            "properties": {
              "download_available": {"const": false},
              "expires_at": {"type": "null"},
              "error_class": {"$ref": "common.schema.json#/$defs/exportErrorClass"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "expired"}}, "required": ["status"]},
          "then": {
            "properties": {
              "download_available": {"const": false},
              "completed_at": {"type": "string", "format": "date-time"},
              "expires_at": {"type": "string", "format": "date-time"},
              "error_class": {"type": "null"}
            }
          }
        }
      ]
    }
  },
  "$ref": "#/$defs/exportStatus"
}

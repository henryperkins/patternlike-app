  "amendments": [
    {
      "date": "2026-08-15",
      "change": "Added patternConsentRevocation to pattern-consent.schema.json and pointed DELETE /v1/consents/pattern-generation at it.",
      "reason": "Design spec 19.3 documents the revoke response as a {schema_version, consent, existing_pattern_retained} envelope and the route emits one, but the OpenAPI response and x-normative-schema both named the bare patternConsent, which the envelope does not validate against. Purely additive: no existing def, enum, required field, or $id changed."
    }
  ]

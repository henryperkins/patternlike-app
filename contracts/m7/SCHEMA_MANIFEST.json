      "relationship": "constrained_model_operational_predecessor",
      "note": "M7 copies M5 frozen-command, encrypted-outbox, and strict-provider posture. It does not widen ai_synthesis or the daily-reading command."
    },
    {
      "package": "contracts/m6",
      "schema_version": "0.6.0",
      "manifest_sha256": "4ead039fd6a264555c2712f1eb950352eccfb9ca78e10a8d9f03c1e00159c148",
      "relationship": "export_lifecycle_predecessor",
      "note": "M6 account-export remains frozen. M7 ships a successor export document with an explicit patterns section."
    }
  ],
  "supersedes": [
    {
      "family": "consumer-pattern-success",
      "documents": [
        "m4:pattern-response.schema.json#/$defs/patternResponse"

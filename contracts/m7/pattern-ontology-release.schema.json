{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patternlike.app/contracts/m7/pattern-ontology-release.schema.json",
  "title": "Pattern ontology release",
  "$defs": {
    "patternOntologyRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "ontology_version",
        "bundle_hash",
        "corpus_release_hash",
        "locale",
        "status",
        "records",
        "evaluation"
      ],
      "properties": {
        "schema_version": { "$ref": "https://patternlike.app/contracts/m7/common.schema.json#/$defs/schemaVersion" },
        "ontology_version": { "type": "string", "minLength": 1 },
        "bundle_hash": { "$ref": "https://patternlike.app/contracts/m7/common.schema.json#/$defs/contentHash" },
        "corpus_release_hash": { "$ref": "https://patternlike.app/contracts/m7/common.schema.json#/$defs/contentHash" },
        "locale": { "$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/localeTag" },
        "status": { "type": "string", "enum": ["candidate", "active", "superseded", "recalled"] },
        "records": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "https://patternlike.app/contracts/m7/pattern-ontology-record.schema.json#/$defs/patternOntologyRecord" }
        },
        "evaluation": { "$ref": "https://patternlike.app/contracts/m7/pattern-ontology-evaluation.schema.json#/$defs/patternOntologyEvaluation" }
      }
    }
  },
  "$ref": "#/$defs/patternOntologyRelease"
}

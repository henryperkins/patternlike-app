{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patternlike.app/contracts/m7/pattern-planner-output.schema.json",
  "title": "Pattern planner output (strict structured output)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "chapters", "additional_signatures", "omissions"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["0.7.0"] },
    "chapters": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/plannerChapter" }
    },
    "additional_signatures": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/plannerSignature" }
    },
    "omissions": {
      "type": "array",
      "items": { "$ref": "#/$defs/plannerOmission" }
    }
  },
  "$defs": {
    "plannerChapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter_key",
        "working_title",
        "purpose",
        "feature_aliases",
        "ontology_rule_ids",
        "derived_synthesis_ids",
        "required_tension_ids",
        "required_resource_ids",
        "required_counter_expression_ids"
      ],
      "properties": {
        "chapter_key": { "type": "string", "pattern": "^chapter_[0-9]{2}$" },
        "working_title": { "type": "string", "minLength": 1, "maxLength": 90 },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 400 },
        "feature_aliases": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^f[0-9]{3}$" } },
        "ontology_rule_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "derived_synthesis_ids": { "type": "array", "items": { "type": "string" } },
        "required_tension_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "required_resource_ids": { "type": "array", "items": { "type": "string" } },
        "required_counter_expression_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "plannerSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signature_key", "working_title", "feature_aliases", "ontology_rule_ids"],
      "properties": {
        "signature_key": { "type": "string", "pattern": "^signature_[0-9]{2}$" },
        "working_title": { "type": "string", "minLength": 1, "maxLength": 90 },
        "feature_aliases": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^f[0-9]{3}$" } },
        "ontology_rule_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "plannerOmission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_alias", "reason", "covered_by"],
      "properties": {
        "feature_alias": { "type": "string", "pattern": "^f[0-9]{3}$" },
        "reason": {
          "type": "string",
          "enum": ["redundant_with_chapter", "capacity_omitted", "cluster_incompatible", "sparse_document"]
        },
        "covered_by": { "type": ["string", "null"] }
      }
    }
  }
}

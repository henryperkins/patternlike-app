{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patternlike.app/contracts/m7/pattern-selection-manifest.schema.json",
  "title": "Pattern selection manifest",
  "$defs": {
    "patternSelectionManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "policy_id",
        "policy_version",
        "feature_set_hash",
        "sparse_pattern",
        "accounting"
      ],
      "properties": {
        "schema_version": { "$ref": "https://patternlike.app/contracts/m7/common.schema.json#/$defs/schemaVersion" },
        "policy_id": { "type": "string", "const": "pattern-selection-policy" },
        "policy_version": { "type": "string", "const": "1.0.0" },
        "feature_set_hash": { "$ref": "https://patternlike.app/contracts/m7/common.schema.json#/$defs/contentHash" },
        "sparse_pattern": { "type": "boolean" },
        "accounting": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/featureAccounting" }
        }
      }
    },
    "featureAccounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_id", "alias", "coverage", "reason"],
      "properties": {
        "feature_id": { "$ref": "https://patternlike.app/contracts/m4/common.schema.json#/$defs/featureId" },
        "alias": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "https://patternlike.app/contracts/m7/common.schema.json#/$defs/featureAlias" }
          ]
        },
        "coverage": { "$ref": "https://patternlike.app/contracts/m7/common.schema.json#/$defs/coverageClass" },
        "reason": { "type": ["string", "null"] }
      }
    }
  },
  "$ref": "#/$defs/patternSelectionManifest"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patternlike.app/contracts/m7/pattern-state.schema.json",
  "title": "Pattern state",
  "$defs": {
    "patternStateDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "state", "chart", "consent", "generation", "pattern"],
      "properties": {
        "schema_version": { "$ref": "https://patternlike.app/contracts/m7/common.schema.json#/$defs/schemaVersion" },
        "state": { "$ref": "https://patternlike.app/contracts/m7/common.schema.json#/$defs/patternState" },
        "chart": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["chart_id", "effective_accuracy", "feature_policy_version"],
              "properties": {
                "chart_id": { "$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/opaqueId" },
                "effective_accuracy": { "$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/birthTimeAccuracy" },
                "feature_policy_version": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "consent": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "https://patternlike.app/contracts/m7/pattern-consent.schema.json#/$defs/patternConsent" }
          ]
        },
        "generation": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["generation_id", "stage", "status_updated_at", "started_at", "retryable", "request_id"],
              "properties": {
                "generation_id": { "$ref": "https://patternlike.app/contracts/m7/common.schema.json#/$defs/generationId" },
                "stage": { "type": "string", "enum": ["organizing_evidence", "writing", "checking_claims"] },
                "status_updated_at": { "$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/isoDateTime" },
                "started_at": { "$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/isoDateTime" },
                "retryable": { "type": "boolean" },
                "request_id": { "type": ["string", "null"] }
              }
            }
          ]
        },
        "pattern": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["pattern_id", "generated_at", "locale", "effective_accuracy"],
              "properties": {
                "pattern_id": { "$ref": "https://patternlike.app/contracts/m7/common.schema.json#/$defs/patternId" },
                "generated_at": { "$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/isoDateTime" },
                "locale": { "$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/localeTag" },
                "effective_accuracy": { "$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/birthTimeAccuracy" }
              }
            }
          ]
        }
      }
    }
  },
  "$ref": "#/$defs/patternStateDocument"
}

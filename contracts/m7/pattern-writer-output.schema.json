{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patternlike.app/contracts/m7/pattern-writer-output.schema.json",
  "title": "Pattern writer output (strict structured output)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "chapters", "additional_signatures", "uncertainty_note"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["0.7.0"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 90 },
    "chapters": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/writerChapter" }
    },
    "additional_signatures": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/writerSignature" }
    },
    "uncertainty_note": {
      "anyOf": [{ "$ref": "#/$defs/proseUnit" }, { "type": "null" }]
    }
  },
  "$defs": {
    "proseUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "claim_class", "feature_aliases", "ontology_rule_ids", "derived_synthesis_ids"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "claim_class": {
          "type": "string",
          "enum": [
            "reflective_interpretation",
            "structural_description",
            "tension",
            "resource",
            "counter_expression",
            "uncertainty"
          ]
        },
        "feature_aliases": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^f[0-9]{3}$" } },
        "ontology_rule_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "derived_synthesis_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "writerSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_key", "text", "claim_class", "feature_aliases", "ontology_rule_ids", "derived_synthesis_ids"],
      "properties": {
        "section_key": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "claim_class": {
          "type": "string",
          "enum": ["reflective_interpretation", "structural_description"]
        },
        "feature_aliases": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^f[0-9]{3}$" } },
        "ontology_rule_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "derived_synthesis_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "writerChapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter_key",
        "title",
        "summary",
        "sections",
        "tensions",
        "resources",
        "counter_expression"
      ],
      "properties": {
        "chapter_key": { "type": "string", "pattern": "^chapter_[0-9]{2}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 90 },
        "summary": { "type": "string", "minLength": 1 },
        "sections": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "$ref": "#/$defs/writerSection" } },
        "tensions": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/proseUnit" } },
        "resources": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/proseUnit" } },
        "counter_expression": { "$ref": "#/$defs/proseUnit" }
      }
    },
    "writerSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signature_key", "title", "text", "feature_aliases", "ontology_rule_ids"],
      "properties": {
        "signature_key": { "type": "string", "pattern": "^signature_[0-9]{2}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 90 },
        "text": { "type": "string", "minLength": 1 },
        "feature_aliases": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^f[0-9]{3}$" } },
        "ontology_rule_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}

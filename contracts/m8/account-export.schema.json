{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patternlike.app/contracts/m8/account-export.schema.json",
  "title": "M8 portable account export successor",
  "description": "Forward-only successor to the M7 export document. It preserves the M7 section structure and adds nullable saved_at only to exported daily-reading items.",
  "$defs": {
    "portableSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "items"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["included", "omitted_by_request", "not_available"]
        },
        "items": { "type": "array", "items": {} }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["omitted_by_request", "not_available"]
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "items": { "maxItems": 0 }
            }
          }
        }
      ]
    },
    "exportedPattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern_id",
        "status",
        "generated_at",
        "locale",
        "effective_accuracy",
        "artifact"
      ],
      "properties": {
        "pattern_id": {
          "$ref": "https://patternlike.app/contracts/m7/common.schema.json#/$defs/patternId"
        },
        "status": { "type": "string", "const": "active" },
        "generated_at": {
          "$ref": "https://patternlike.app/contracts/m8/common.schema.json#/$defs/dateTime"
        },
        "locale": {
          "$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/localeTag"
        },
        "effective_accuracy": {
          "$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/birthTimeAccuracy"
        },
        "artifact": {
          "$ref": "https://patternlike.app/contracts/m7/pattern-response.schema.json#/$defs/patternResponse"
        }
      }
    },
    "m3EvidenceHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "reading_id",
        "local_date",
        "release_version",
        "chart_fingerprint",
        "assembly_mode",
        "assembly_id",
        "assembly_policy_version",
        "revision",
        "primary_theme",
        "supporting_theme",
        "validation",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "$ref": "https://patternlike.app/contracts/m3/reading-evidence.schema.json#/$defs/readingEvidenceGraph/properties/schema_version"
        },
        "reading_id": {
          "$ref": "https://patternlike.app/contracts/m3/reading-evidence.schema.json#/$defs/readingEvidenceGraph/properties/reading_id"
        },
        "local_date": {
          "$ref": "https://patternlike.app/contracts/m3/reading-evidence.schema.json#/$defs/readingEvidenceGraph/properties/local_date"
        },
        "release_version": {
          "$ref": "https://patternlike.app/contracts/m3/reading-evidence.schema.json#/$defs/readingEvidenceGraph/properties/release_version"
        },
        "chart_fingerprint": {
          "$ref": "https://patternlike.app/contracts/m3/reading-evidence.schema.json#/$defs/readingEvidenceGraph/properties/chart_fingerprint"
        },
        "assembly_mode": {
          "type": "string",
          "const": "deterministic"
        },
        "assembly_id": {
          "$ref": "https://patternlike.app/contracts/m3/reading-evidence.schema.json#/$defs/readingEvidenceGraph/properties/assembly_id"
        },
        "assembly_policy_version": {
          "$ref": "https://patternlike.app/contracts/m3/reading-evidence.schema.json#/$defs/readingEvidenceGraph/properties/assembly_policy_version"
        },
        "revision": {
          "$ref": "https://patternlike.app/contracts/m3/reading-evidence.schema.json#/$defs/readingEvidenceGraph/properties/revision"
        },
        "primary_theme": {
          "$ref": "https://patternlike.app/contracts/m3/reading-evidence.schema.json#/$defs/readingEvidenceGraph/properties/primary_theme"
        },
        "supporting_theme": {
          "$ref": "https://patternlike.app/contracts/m3/reading-evidence.schema.json#/$defs/readingEvidenceGraph/properties/supporting_theme"
        },
        "validation": {
          "$ref": "https://patternlike.app/contracts/m3/reading-evidence.schema.json#/$defs/readingEvidenceGraph/properties/validation"
        },
        "created_at": {
          "$ref": "https://patternlike.app/contracts/m3/reading-evidence.schema.json#/$defs/readingEvidenceGraph/properties/created_at"
        }
      }
    },
    "m5EvidenceHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "reading_id",
        "revision",
        "revision_reason",
        "generated_at",
        "generation_input_id",
        "input_manifest_hash",
        "content_hash",
        "provider_response_hash",
        "calculation",
        "model",
        "validation"
      ],
      "properties": {
        "schema_version": {
          "$ref": "https://patternlike.app/contracts/m5/reading-evidence.schema.json#/$defs/readingEvidenceGraphV5/properties/schema_version"
        },
        "reading_id": {
          "$ref": "https://patternlike.app/contracts/m5/reading-evidence.schema.json#/$defs/readingEvidenceGraphV5/properties/reading_id"
        },
        "revision": {
          "$ref": "https://patternlike.app/contracts/m5/reading-evidence.schema.json#/$defs/readingEvidenceGraphV5/properties/revision"
        },
        "revision_reason": {
          "$ref": "https://patternlike.app/contracts/m5/reading-evidence.schema.json#/$defs/readingEvidenceGraphV5/properties/revision_reason"
        },
        "generated_at": {
          "$ref": "https://patternlike.app/contracts/m5/reading-evidence.schema.json#/$defs/readingEvidenceGraphV5/properties/generated_at"
        },
        "generation_input_id": {
          "$ref": "https://patternlike.app/contracts/m5/reading-evidence.schema.json#/$defs/readingEvidenceGraphV5/properties/generation_input_id"
        },
        "input_manifest_hash": {
          "$ref": "https://patternlike.app/contracts/m5/reading-evidence.schema.json#/$defs/readingEvidenceGraphV5/properties/input_manifest_hash"
        },
        "content_hash": {
          "$ref": "https://patternlike.app/contracts/m5/reading-evidence.schema.json#/$defs/readingEvidenceGraphV5/properties/content_hash"
        },
        "provider_response_hash": {
          "$ref": "https://patternlike.app/contracts/m5/reading-evidence.schema.json#/$defs/readingEvidenceGraphV5/properties/provider_response_hash"
        },
        "calculation": {
          "$ref": "https://patternlike.app/contracts/m5/reading-evidence.schema.json#/$defs/readingEvidenceGraphV5/properties/calculation"
        },
        "model": {
          "$ref": "https://patternlike.app/contracts/m5/reading-evidence.schema.json#/$defs/readingEvidenceGraphV5/properties/model"
        },
        "validation": {
          "$ref": "https://patternlike.app/contracts/m5/reading-evidence.schema.json#/$defs/readingEvidenceGraphV5/properties/validation"
        }
      },
      "allOf": [
        {
          "$ref": "https://patternlike.app/contracts/m5/reading-evidence.schema.json#/$defs/readingEvidenceGraphV5/allOf/0"
        }
      ]
    },
    "m3StoredReadingArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reading",
        "assembly_id",
        "content_hash",
        "primary_cycle_id",
        "supporting_cycle_id",
        "validation",
        "evidence_header"
      ],
      "properties": {
        "reading": {
          "$ref": "https://patternlike.app/contracts/m3/daily-reading.schema.json#/$defs/dailyReading"
        },
        "assembly_id": {
          "$ref": "https://patternlike.app/contracts/m3/common.schema.json#/$defs/assemblyId"
        },
        "content_hash": {
          "$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/contentHash"
        },
        "primary_cycle_id": {
          "oneOf": [
            {
              "$ref": "https://patternlike.app/contracts/m3/common.schema.json#/$defs/cycleId"
            },
            { "type": "null" }
          ]
        },
        "supporting_cycle_id": {
          "oneOf": [
            {
              "$ref": "https://patternlike.app/contracts/m3/common.schema.json#/$defs/cycleId"
            },
            { "type": "null" }
          ]
        },
        "validation": {
          "$ref": "https://patternlike.app/contracts/m3/reading-evidence.schema.json#/$defs/validationResult"
        },
        "evidence_header": { "$ref": "#/$defs/m3EvidenceHeader" }
      }
    },
    "readingInvalidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "actor_class", "invalidated_at"],
      "properties": {
        "reason": {
          "type": "string",
          "enum": ["chart_correction", "calculation_defect"]
        },
        "actor_class": {
          "type": "string",
          "enum": ["user_change", "operator"]
        },
        "invalidated_at": {
          "$ref": "https://patternlike.app/contracts/m8/common.schema.json#/$defs/dateTime"
        }
      }
    },
    "m5StoredReadingArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "reading",
        "evidence_header",
        "invalidation"
      ],
      "properties": {
        "schema_version": {
          "$ref": "https://patternlike.app/contracts/m5/common.schema.json#/$defs/schemaVersion"
        },
        "reading": {
          "$ref": "https://patternlike.app/contracts/m5/daily-reading.schema.json#/$defs/dailyReadingV5"
        },
        "evidence_header": { "$ref": "#/$defs/m5EvidenceHeader" },
        "invalidation": {
          "oneOf": [
            { "$ref": "#/$defs/readingInvalidation" },
            { "type": "null" }
          ]
        }
      }
    },
    "m3ExportedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "header", "paragraphs"],
      "properties": {
        "schema_version": {
          "$ref": "https://patternlike.app/contracts/m3/common.schema.json#/$defs/schemaVersion"
        },
        "header": { "$ref": "#/$defs/m3EvidenceHeader" },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://patternlike.app/contracts/m3/reading-evidence.schema.json#/$defs/paragraphEvidence"
          }
        }
      }
    },
    "m5ExportedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "header", "paragraphs"],
      "properties": {
        "schema_version": {
          "$ref": "https://patternlike.app/contracts/m5/common.schema.json#/$defs/schemaVersion"
        },
        "header": { "$ref": "#/$defs/m5EvidenceHeader" },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://patternlike.app/contracts/m5/reading-evidence.schema.json#/$defs/paragraphEvidenceV5"
          }
        }
      }
    },
    "exportedDailyReading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "local_date",
        "release_version",
        "chart_fingerprint",
        "contract_id",
        "assembly_mode",
        "status",
        "revision",
        "revision_reason",
        "supersedes_reading_id",
        "invalidated_at",
        "created_at",
        "updated_at",
        "artifact",
        "evidence",
        "saved_at"
      ],
      "properties": {
        "id": {
          "$ref": "https://patternlike.app/contracts/m8/common.schema.json#/$defs/readingId"
        },
        "local_date": {
          "$ref": "https://patternlike.app/contracts/m8/common.schema.json#/$defs/localDate"
        },
        "release_version": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 128 }
          ]
        },
        "chart_fingerprint": {
          "$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/contentHash"
        },
        "contract_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "assembly_mode": {
          "$ref": "https://patternlike.app/contracts/m8/common.schema.json#/$defs/assemblyMode"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "published", "failed", "superseded", "invalidated"]
        },
        "revision": {
          "$ref": "https://patternlike.app/contracts/m8/common.schema.json#/$defs/readingRevision"
        },
        "revision_reason": {
          "$ref": "https://patternlike.app/contracts/m8/common.schema.json#/$defs/revisionReason"
        },
        "supersedes_reading_id": {
          "oneOf": [
            { "type": "null" },
            {
              "$ref": "https://patternlike.app/contracts/m8/common.schema.json#/$defs/readingId"
            }
          ]
        },
        "invalidated_at": {
          "$ref": "https://patternlike.app/contracts/m8/common.schema.json#/$defs/nullableDateTime"
        },
        "created_at": {
          "$ref": "https://patternlike.app/contracts/m8/common.schema.json#/$defs/dateTime"
        },
        "updated_at": {
          "$ref": "https://patternlike.app/contracts/m8/common.schema.json#/$defs/dateTime"
        },
        "artifact": {
          "oneOf": [
            { "$ref": "#/$defs/m3StoredReadingArtifact" },
            { "$ref": "#/$defs/m5StoredReadingArtifact" },
            { "type": "null" }
          ]
        },
        "evidence": {
          "oneOf": [
            { "$ref": "#/$defs/m3ExportedEvidence" },
            { "$ref": "#/$defs/m5ExportedEvidence" },
            { "type": "null" }
          ]
        },
        "saved_at": {
          "$ref": "https://patternlike.app/contracts/m8/common.schema.json#/$defs/nullableDateTime"
        }
      },
      "oneOf": [
        {
          "properties": {
            "artifact": { "$ref": "#/$defs/m3StoredReadingArtifact" },
            "evidence": { "$ref": "#/$defs/m3ExportedEvidence" }
          },
          "required": ["artifact", "evidence"]
        },
        {
          "properties": {
            "artifact": { "$ref": "#/$defs/m5StoredReadingArtifact" },
            "evidence": { "$ref": "#/$defs/m5ExportedEvidence" }
          },
          "required": ["artifact", "evidence"]
        },
        {
          "properties": {
            "artifact": { "type": "null" },
            "evidence": { "type": "null" }
          },
          "required": ["artifact", "evidence"]
        }
      ]
    },
    "readingSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "items"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["included", "omitted_by_request", "not_available"]
        },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/exportedDailyReading" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["omitted_by_request", "not_available"]
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "items": { "maxItems": 0 }
            }
          }
        }
      ]
    },
    "patternSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "items"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["included", "omitted_by_request", "not_available"]
        },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/exportedPattern" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["omitted_by_request", "not_available"]
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "items": { "maxItems": 0 }
            }
          }
        }
      ]
    },
    "accountExport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "export_id",
        "generated_at",
        "account",
        "birth_profiles",
        "chart_snapshots",
        "preferences",
        "timezone_changes",
        "consents",
        "context_sources",
        "context_signals",
        "readings",
        "journal",
        "patterns"
      ],
      "properties": {
        "schema_version": {
          "$ref": "https://patternlike.app/contracts/m8/common.schema.json#/$defs/schemaVersion"
        },
        "export_id": {
          "$ref": "https://patternlike.app/contracts/m0/common.schema.json#/$defs/opaqueId"
        },
        "generated_at": {
          "$ref": "https://patternlike.app/contracts/m8/common.schema.json#/$defs/dateTime"
        },
        "account": {
          "$ref": "https://patternlike.app/contracts/m6/account-export.schema.json#/$defs/accountProfile"
        },
        "birth_profiles": {
          "type": "array",
          "items": {
            "$ref": "https://patternlike.app/contracts/m6/account-export.schema.json#/$defs/birthProfile"
          }
        },
        "chart_snapshots": {
          "type": "array",
          "items": {
            "$ref": "https://patternlike.app/contracts/m6/account-export.schema.json#/$defs/chartSnapshot"
          }
        },
        "preferences": {
          "$ref": "https://patternlike.app/contracts/m6/account-export.schema.json#/$defs/preferenceSnapshot"
        },
        "timezone_changes": {
          "type": "array",
          "items": {
            "$ref": "https://patternlike.app/contracts/m6/account-export.schema.json#/$defs/timezoneChange"
          }
        },
        "consents": {
          "type": "array",
          "items": {
            "$ref": "https://patternlike.app/contracts/m0/consent.schema.json#/$defs/consentRecord"
          }
        },
        "context_sources": {
          "type": "array",
          "items": {
            "$ref": "https://patternlike.app/contracts/m0/consent.schema.json#/$defs/contextSourcePermission"
          }
        },
        "context_signals": {
          "type": "array",
          "items": {
            "$ref": "https://patternlike.app/contracts/m0/context-signal.schema.json"
          }
        },
        "readings": { "$ref": "#/$defs/readingSection" },
        "journal": { "$ref": "#/$defs/portableSection" },
        "patterns": { "$ref": "#/$defs/patternSection" }
      }
    }
  },
  "$ref": "#/$defs/accountExport"
}

{
  "policy_id": "pattern-provider-boundary",
  "version": "1.0.0",
  "forbidden_keys": [
    "user_id",
    "chart_id",
    "chart_fingerprint",
    "chart_fingerprint_hash",
    "fingerprint",
    "birth_date",
    "birth_time",
    "birthplace",
    "consent_id",
    "check_in",
    "check_ins",
    "journal",
    "life_event",
    "life_events",
    "reading",
    "readings",
    "daily_reading",
    "latitude",
    "aliasMap",
    "alias_map"
  ],

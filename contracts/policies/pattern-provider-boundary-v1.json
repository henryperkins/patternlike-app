    { "prefix": "csr_", "match": "substring" },
    { "prefix": "ctx_", "match": "substring" },
    { "prefix": "cyc_", "match": "substring" },
    { "prefix": "cyp_", "match": "substring" },
    { "prefix": "del_", "match": "substring" },
    { "prefix": "dsf_", "match": "substring" },
    { "prefix": "evt_", "match": "substring" },

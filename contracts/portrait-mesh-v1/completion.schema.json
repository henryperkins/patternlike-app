{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patternlike.dev/contracts/portrait-mesh-v1/completion.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lease_token",
    "program",
    "program_sha256",
    "glb_base64",
    "glb_sha256",
    "compiler_version",
    "audit",
    "provider_request_id",
    "audit_request_id"
  ],
  "properties": {
    "lease_token": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "program": {
      "$ref": "./program.schema.json"
    },
    "program_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "glb_base64": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000000,
      "contentEncoding": "base64"
    },
    "glb_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "compiler_version": {
      "const": "portrait-mesh-compiler/v1"
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "accepted",
        "recognizable",
        "substantial",
        "source_correspondence",
        "no_severe_intersections",
        "view_count",
        "notes"
      ],
      "properties": {
        "schema_version": {
          "const": "portrait-mesh-audit/v1"
        },
        "accepted": {
          "const": true
        },
        "recognizable": {
          "const": true
        },
        "substantial": {
          "const": true
        },
        "source_correspondence": {
          "const": true
        },
        "no_severe_intersections": {
          "const": true
        },
        "view_count": {
          "const": 4
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "provider_request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "audit_request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  }
}

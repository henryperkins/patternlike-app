{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patternlike.app/contracts/portrait-mesh-v2/failure.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lease_token",
    "code",
    "schema_version",
    "chapter_count",
    "chapter_index",
    "chapter_id",
    "document_revision"
  ],
  "properties": {
    "lease_token": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "code": {
      "enum": [
        "generation_failed",
        "generation_refused",
        "program_invalid",
        "model_invalid",
        "visual_check_failed",
        "authentication_failed"
      ]
    },
    "schema_version": {
      "const": "codex-portrait-mesh-failure/v2"
    },
    "chapter_count": {
      "type": "integer",
      "enum": [
        3,
        4,
        5,
        6
      ]
    },
    "chapter_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "chapter_id": {
      "type": "string",
      "pattern": "^chapter-[1-6]$"
    },
    "document_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "chapter_count": {
            "const": 3
          }
        }
      },
      "then": {
        "properties": {
          "chapter_index": {
            "maximum": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "chapter_count": {
            "const": 4
          }
        }
      },
      "then": {
        "properties": {
          "chapter_index": {
            "maximum": 3
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "chapter_count": {
            "const": 5
          }
        }
      },
      "then": {
        "properties": {
          "chapter_index": {
            "maximum": 4
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "chapter_count": {
            "const": 6
          }
        }
      },
      "then": {
        "properties": {
          "chapter_index": {
            "maximum": 5
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "chapter_index": {
            "const": 0
          }
        }
      },
      "then": {
        "properties": {
          "chapter_id": {
            "const": "chapter-1"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "chapter_index": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "chapter_id": {
            "const": "chapter-2"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "chapter_index": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "chapter_id": {
            "const": "chapter-3"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "chapter_index": {
            "const": 3
          }
        }
      },
      "then": {
        "properties": {
          "chapter_id": {
            "const": "chapter-4"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "chapter_index": {
            "const": 4
          }
        }
      },
      "then": {
        "properties": {
          "chapter_id": {
            "const": "chapter-5"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "chapter_index": {
            "const": 5
          }
        }
      },
      "then": {
        "properties": {
          "chapter_id": {
            "const": "chapter-6"
          }
        }
      }
    }
  ]
}
